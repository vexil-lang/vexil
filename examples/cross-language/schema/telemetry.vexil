namespace sensor.telemetry

enum DeviceStatus {
    Online    @0
    Degraded  @1
    Offline   @2
    Error     @3
}

message SensorReading {
    device_id   @0 : u32
    battery     @1 : u7
    signal      @2 : u4
    status      @3 : DeviceStatus
    temperature @4 : f32
    humidity    @5 : f32
    label       @6 : string
    gps_lat     @7 : optional<f64>
    gps_lon     @8 : optional<f64>
}
