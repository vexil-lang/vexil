namespace project.messages

import { Permissions, Priority, TaskState, Timestamp } from project.types

message Task {
    id          @0 : u64 @varint
    title       @1 : string @limit(256)
    priority    @2 : Priority
    created_at  @3 : Timestamp
    permissions @4 : Permissions
    state       @5 : TaskState
}

message TaskList {
    tasks @0 : array<Task>
}
