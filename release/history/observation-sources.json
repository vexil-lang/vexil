{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vexil.dev/release/history/observation-sources.json",
  "version": "1.0",
  "sources": [
    {"id": "git-remote-tags", "kind": "git", "readOnlyQuery": "git ls-remote --tags <remote>"},
    {"id": "repository-changelog", "kind": "repository-file", "readOnlyQuery": "read CHANGELOG.md"},
    {"id": "github-releases", "kind": "github-release", "readOnlyQuery": "GET /repos/vexil-lang/vexil/releases"},
    {"id": "package-manifests", "kind": "manifest", "readOnlyQuery": "read package manifests"},
    {"id": "release-artifacts", "kind": "artifact", "readOnlyQuery": "GET immutable release assets"},
    {"id": "crates-io", "kind": "registry", "readOnlyQuery": "GET crates.io package metadata"},
    {"id": "npm", "kind": "registry", "readOnlyQuery": "GET npm package metadata"},
    {"id": "pypi", "kind": "registry", "readOnlyQuery": "GET PyPI project metadata"},
    {"id": "go-proxy", "kind": "go-proxy", "readOnlyQuery": "GET Go module proxy metadata"}
  ]
}
