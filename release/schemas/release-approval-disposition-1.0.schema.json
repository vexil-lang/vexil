{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://vexil.dev/release/schemas/release-approval-disposition-1.0.schema.json","type":"object","additionalProperties":false,"required":["$schema","recordKind","schemaVersion","dispositionId","approvalId","approvalDigest","effectiveAt","disposition","authority","reason","sourceEvidence"],"properties":{"$schema":{"const":"https://vexil.dev/release/schemas/release-approval-disposition-1.0.schema.json"},"recordKind":{"const":"release-approval-disposition"},"schemaVersion":{"const":"1.0"},"dispositionId":{"$ref":"#/$defs/id"},"approvalId":{"$ref":"#/$defs/id"},"approvalDigest":{"$ref":"#/$defs/digest"},"effectiveAt":{"$ref":"#/$defs/time"},"disposition":{"enum":["withdrawn","revoked"]},"authority":{"$ref":"#/$defs/principal"},"reason":{"type":"string","minLength":1},"sourceEvidence":{"$ref":"#/$defs/publicEvidence"}},"$defs":{"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$"},"digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"time":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},"principal":{"type":"object","additionalProperties":false,"required":["actor","role","assignment"],"properties":{"actor":{"type":"string","minLength":1},"role":{"const":"repository-administrator"},"assignment":{"type":"string","minLength":1}}},"publicEvidence":{"type":"object","additionalProperties":false,"required":["source","observedAt","collector"],"properties":{"source":{"type":"string","pattern":"^https://[^/]+/.+"},"observedAt":{"$ref":"#/$defs/time"},"collector":{"type":"string","minLength":1}}}}}
