{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://vexil.dev/release/schemas/privileged-run-start-authorization-1.0.schema.json",
  "type":"object",
  "additionalProperties":false,
  "required":["$schema","recordKind","schemaVersion","authorizationId","runId","manifestId","manifestDigest","evidenceSetId","evidenceSetDigest","selectedApprovals","governanceRevision","historicalTagBaseline","historicalTagSnapshot","security","candidate","targetControlEvidence","stateSchema","reducer","issuer","executionPrincipal","workload","protectedEnvironment","allowedOperations","allowedUnits","allowedTargets","allowedPermissions","materializationPath","issuedAt","notBefore","expiresAt"],
  "properties":{
    "$schema":{"const":"https://vexil.dev/release/schemas/privileged-run-start-authorization-1.0.schema.json"},
    "recordKind":{"const":"privileged-run-start-authorization"},
    "schemaVersion":{"const":"1.0"},
    "authorizationId":{"$ref":"#/$defs/id"},
    "runId":{"$ref":"#/$defs/id"},
    "manifestId":{"$ref":"#/$defs/id"},
    "manifestDigest":{"$ref":"#/$defs/digest"},
    "evidenceSetId":{"$ref":"#/$defs/id"},
    "evidenceSetDigest":{"$ref":"#/$defs/digest"},
    "selectedApprovals":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/selectedApproval"}},
    "governanceRevision":{"$ref":"#/$defs/identityDigest"},
    "historicalTagBaseline":{"$ref":"#/$defs/identityDigest"},
    "historicalTagSnapshot":{"$ref":"#/$defs/identityDigest"},
    "security":{"$ref":"#/$defs/security"},
    "candidate":{"$ref":"#/$defs/candidate"},
    "targetControlEvidence":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/targetControlEvidence"}},
    "stateSchema":{"$ref":"#/$defs/artifact"},
    "reducer":{"$ref":"#/$defs/artifact"},
    "issuer":{"$ref":"#/$defs/releaseStewardPrincipal"},
    "executionPrincipal":{"$ref":"#/$defs/releaseRunCoordinatorPrincipal"},
    "workload":{"type":"string","minLength":1},
    "protectedEnvironment":{"type":"string","minLength":1},
    "allowedOperations":{"$ref":"#/$defs/nonemptyUniqueStrings"},
    "allowedUnits":{"$ref":"#/$defs/nonemptyUniqueStrings"},
    "allowedTargets":{"$ref":"#/$defs/nonemptyUniqueStrings"},
    "allowedPermissions":{"$ref":"#/$defs/nonemptyUniqueStrings"},
    "materializationPath":{"type":"string","pattern":"^release/runs/[a-z0-9][a-z0-9._-]*/start-authorization[.]json$"},
    "issuedAt":{"$ref":"#/$defs/time"},
    "notBefore":{"$ref":"#/$defs/time"},
    "expiresAt":{"$ref":"#/$defs/time"}
  },
  "$defs":{
    "id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]*$"},
    "digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "time":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "identityDigest":{"type":"object","additionalProperties":false,"required":["id","digest"],"properties":{"id":{"type":"string","minLength":1},"digest":{"$ref":"#/$defs/digest"}}},
    "selectedApproval":{"type":"object","additionalProperties":false,"required":["approvalId","approvalDigest","disposition"],"properties":{"approvalId":{"$ref":"#/$defs/id"},"approvalDigest":{"$ref":"#/$defs/digest"},"disposition":{"anyOf":[{"type":"null"},{"$ref":"#/$defs/identityDigest"}]}}},
    "security":{"type":"object","additionalProperties":false,"required":["findingsDigest","exceptionsDigest"],"properties":{"findingsDigest":{"$ref":"#/$defs/digest"},"exceptionsDigest":{"$ref":"#/$defs/digest"}}},
    "candidate":{"type":"object","additionalProperties":false,"required":["bundleId","bundleDigest","subjectDigest","attestationDigest"],"properties":{"bundleId":{"$ref":"#/$defs/id"},"bundleDigest":{"$ref":"#/$defs/digest"},"subjectDigest":{"$ref":"#/$defs/digest"},"attestationDigest":{"$ref":"#/$defs/digest"}}},
    "targetControlEvidence":{"type":"object","additionalProperties":false,"required":["target","targetControlDigest","permissionDigest"],"properties":{"target":{"type":"string","minLength":1},"targetControlDigest":{"$ref":"#/$defs/digest"},"permissionDigest":{"$ref":"#/$defs/digest"}}},
    "nonemptyUniqueStrings":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "artifact":{"type":"object","additionalProperties":false,"required":["id","version","digest"],"properties":{"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9./_-]*$"},"version":{"type":"string","pattern":"^[0-9]+[.][0-9]+$"},"digest":{"$ref":"#/$defs/digest"}}},
    "releaseStewardPrincipal":{"type":"object","additionalProperties":false,"required":["actor","role","assignment"],"properties":{"actor":{"type":"string","minLength":1},"role":{"const":"release-steward"},"assignment":{"type":"string","minLength":1}}},
    "releaseRunCoordinatorPrincipal":{"type":"object","additionalProperties":false,"required":["actor","role","assignment"],"properties":{"actor":{"type":"string","minLength":1},"role":{"const":"release-run-coordinator"},"assignment":{"type":"string","minLength":1}}}
  }
}
