{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vexil-lang.org/release/schemas/version-rationale.schema.json",
  "title": "Vexil Release Unit Version Rationale",
  "description": "A structural, per-unit version rationale. It is not a Release Manifest, approval, Run, tag, registry operation, or publication assertion.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "$id", "schemaVersion", "recordKind", "rationaleId", "unitId", "previousPackageVersion", "proposedPackageVersion", "changeClass", "affectedSurfaces", "compatibilityEvidenceIdentity", "dependencyImpact", "supportMatrix", "packageStewardReview", "publicCompatibilityDecision", "releaseBoundary"],
  "properties": {
    "$schema": {"const": "https://json-schema.org/draft/2020-12/schema"},
    "$id": {"type": "string", "pattern": "^https://vexil-lang.org/release/rationales/[a-z0-9][a-z0-9-]*[.]json$"},
    "schemaVersion": {"const": "1.0"},
    "recordKind": {"const": "release-unit-version-rationale"},
    "rationaleId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "unitId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "previousPackageVersion": {"$ref": "#/$defs/previousPackageVersion"},
    "proposedPackageVersion": {"$ref": "#/$defs/semver"},
    "changeClass": {"enum": ["initial-source-version", "patch-compatible", "minor-compatible", "major-compatible", "behavior-change", "public-api-change"]},
    "affectedSurfaces": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/affectedSurface"}, "allOf": [{"contains": {"properties": {"namespace": {"const": "language-spec"}}, "required": ["namespace"]}}, {"contains": {"properties": {"namespace": {"const": "wire-format"}}, "required": ["namespace"]}}, {"contains": {"properties": {"namespace": {"const": "package-api"}}, "required": ["namespace"]}}]},
    "compatibilityEvidenceIdentity": {"$ref": "#/$defs/evidenceIdentity"},
    "dependencyImpact": {"$ref": "#/$defs/dependencyImpact"},
    "supportMatrix": {"$ref": "#/$defs/supportMatrix"},
    "packageStewardReview": {"$ref": "#/$defs/packageStewardReview"},
    "publicCompatibilityDecision": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/publicCompatibilityDecision"}]},
    "releaseBoundary": {"const": "structural-rationale-only"}
  },
  "$defs": {
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)(-[0-9A-Za-z-]+([.][0-9A-Za-z-]+)*)?([+][0-9A-Za-z-]+([.][0-9A-Za-z-]+)*)?$"},
    "evidenceIdentity": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "previousPackageVersion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "version", "reason"],
          "properties": {
            "kind": {"const": "initial-non-release-baseline"},
            "version": {"type": "null"},
            "reason": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "version", "observationIds", "reason"],
          "properties": {
            "kind": {"const": "observed-publication-baseline"},
            "version": {"$ref": "#/$defs/semver"},
            "observationIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "affectedSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "surface", "authorityPath", "authorityRevision", "compatibility", "assertion", "languageStatus"],
      "properties": {
        "namespace": {"enum": ["language-spec", "wire-format", "package-api"]},
        "surface": {"type": "string", "minLength": 1},
        "authorityPath": {"type": "string", "pattern": "^(spec|schemas|docs|crates|packages)/[A-Za-z0-9._/-]+$"},
        "authorityRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "compatibility": {"enum": ["compatible", "behavior-changed", "public-api-changed"]},
        "assertion": {"enum": ["source-compatibility-assessment", "formal-conformance"]},
        "languageStatus": {"enum": ["draft", "frozen", "not-applicable"]}
      }
    },
    "dependencyImpact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "affectedUnitIds", "rationale"],
      "properties": {
        "classification": {"enum": ["none", "compatibility-review-required", "release-order-review-required", "unknown-blocks-inclusion"]},
        "affectedUnitIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "supportMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claims", "boundary"],
      "properties": {
        "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/supportClaim"}},
        "boundary": {"const": "each supported claim requires its own evidence identity"}
      }
    },
    "supportClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "languageVersion", "compatibility", "evidenceIdentity"],
      "properties": {
        "platform": {"type": "string", "minLength": 1},
        "languageVersion": {"type": "string", "minLength": 1},
        "compatibility": {"enum": ["supported", "unsupported"]},
        "evidenceIdentity": {"$ref": "#/$defs/evidenceIdentity"}
      }
    },
    "packageStewardReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorId", "roleId", "assignmentId", "reviewedAt"],
      "properties": {
        "actorId": {"type": "string", "pattern": "^github:[A-Za-z0-9-]+$"},
        "roleId": {"const": "package-steward"},
        "assignmentId": {"type": "string", "minLength": 1},
        "reviewedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?Z$"}
      }
    },
    "publicCompatibilityDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisionId", "source", "status", "approvedAt"],
      "properties": {
        "decisionId": {"type": "string", "minLength": 1},
        "source": {"type": "string", "pattern": "^https://github.com/vexil-lang/vexil/issues/[0-9]+$"},
        "status": {"const": "approved"},
        "approvedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?Z$"}
      }
    }
  }
}
