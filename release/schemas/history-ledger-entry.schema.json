{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vexil.dev/release/schemas/history-ledger-entry.schema.json",
  "title": "Vexil Release History Ledger Entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "$id", "version", "recordKind", "entryId", "observationIds", "classification", "reviewState", "review"],
  "properties": {"$schema": {"const": "https://json-schema.org/draft/2020-12/schema"}, "$id": {"type": "string", "pattern": "^https://vexil.dev/release/history/entries/.+[.]json$"}, "version": {"const": "1.0"}, "recordKind": {"const": "release-history-ledger-entry"}, "entryId": {"type": "string", "minLength": 1}, "observationIds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "classification": {"enum": ["confirmed", "missing-observation", "contradiction", "anomaly", "correction"]}, "reviewState": {"enum": ["accepted", "rejected", "unresolved"]}, "review": {"type": "object", "additionalProperties": false, "required": ["actorId", "reviewedAt"], "properties": {"actorId": {"type": "string", "pattern": "^github:"}, "reviewedAt": {"type": "string", "minLength": 20}}}, "correctionOf": {"type": "string", "minLength": 1}, "summary": {"type": "string", "minLength": 1}}
}
