{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vexil.dev/release/schemas/catalog.schema.json",
  "title": "Vexil Release Unit Catalog",
  "description": "Canonical source-led inventory of Vexil release units. It records source declarations and blockers; it is not a release Manifest, publication assertion, or version-selection decision.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "$id", "catalogSchema", "version", "authorityBoundary", "units", "normalization"],
  "properties": {
    "$schema": {"const": "https://json-schema.org/draft/2020-12/schema"},
    "$id": {"const": "https://vexil.dev/release/catalog.json"},
    "catalogSchema": {"const": "https://vexil.dev/release/schemas/catalog.schema.json"},
    "version": {"const": "1.0"},
    "authorityBoundary": {"type": "string", "minLength": 1},
    "units": {"type": "array", "minItems": 18, "items": {"$ref": "#/$defs/unit"}},
    "normalization": {"$ref": "#/$defs/normalization"}
  },
  "$defs": {
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "sourceRoot", "owner", "targets", "publication", "versionSource", "changelog", "compatibilitySurface", "dependencyEdges", "canonicalTagNamespace"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "kind": {"enum": ["rust-package", "typescript-runtime", "python-runtime", "go-module", "non-publishable-package"]},
        "sourceRoot": {"type": "string", "pattern": "^(crates|packages|examples|release)/[A-Za-z0-9._/-]+$"},
        "owner": {"$ref": "#/$defs/owner"},
        "targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/target"}},
        "publication": {"$ref": "#/$defs/publication"},
        "versionSource": {"$ref": "#/$defs/versionSource"},
        "changelog": {"$ref": "#/$defs/changelog"},
        "compatibilitySurface": {"type": "string", "minLength": 1},
        "dependencyEdges": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dependencyEdge"}},
        "canonicalTagNamespace": {"type": "string", "oneOf": [{"const": "not-applicable"}, {"pattern": "^[a-z][a-z0-9-]*-v<semver>$"}, {"const": "packages/runtime-go/v<semver>"}]}
      }
    },
    "owner": {"type": "object", "additionalProperties": false, "required": ["roleId", "assignmentId"], "properties": {"roleId": {"enum": ["package-steward", "repository-administrator"]}, "assignmentId": {"type": "string", "minLength": 1}}},
    "target": {"type": "object", "additionalProperties": false, "required": ["kind", "name"], "properties": {"kind": {"enum": ["cargo-package", "cargo-binary", "npm-package", "python-project", "go-module", "internal-tool", "example"]}, "name": {"type": "string", "minLength": 1}}},
    "publication": {"type": "object", "additionalProperties": false, "required": ["classification", "targetCategory", "status"], "properties": {"classification": {"enum": ["publishable-source-unit", "candidate-unreleased", "blocked-version-source", "non-publishable"]}, "targetCategory": {"enum": ["future-registry-target", "source-only-module", "non-release"]}, "status": {"enum": ["source-inventory-only", "candidate-unreleased", "blocked-missing-version-source", "non-publishable"]}}},
    "versionSource": {"type": "object", "additionalProperties": false, "required": ["path", "format", "observedDeclaration"], "properties": {"path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"}, "format": {"enum": ["cargo-package-version", "package-json-version", "pyproject-project-version", "go-version-file", "required-file-absent"]}, "observedDeclaration": {"type": ["string", "null"]}}},
    "changelog": {"type": "object", "additionalProperties": false, "required": ["status", "path"], "properties": {"status": {"enum": ["present", "absent", "not-applicable"]}, "path": {"type": ["string", "null"]}}},
    "dependencyEdge": {"type": "object", "additionalProperties": false, "required": ["kind", "status", "rationale"], "properties": {"kind": {"enum": ["language-wire", "generated-code", "runtime", "none"]}, "status": {"const": "provisional"}, "rationale": {"type": "string", "minLength": 1}}},
    "normalization": {"type": "object", "additionalProperties": false, "required": ["ordering", "duplicatePolicy", "historyBoundary"], "properties": {"ordering": {"const": "stable-id-ascending"}, "duplicatePolicy": {"const": "reject-duplicate-source-root-or-target"}, "historyBoundary": {"const": "historical-tags-changelog-and-registry-observations-are-evidence-not-version-authority"}}}
  }
}
