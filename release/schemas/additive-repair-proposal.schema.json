{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vexil.dev/release/schemas/additive-repair-proposal.schema.json",
  "title": "Vexil Additive Repair Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "$id", "version", "recordKind", "proposalId", "status", "anomaly", "affectedConsumers", "correctionSurface", "newIdentifier", "approval", "evidenceReferences", "proposedActions"],
  "properties": {"$schema": {"const": "https://json-schema.org/draft/2020-12/schema"}, "$id": {"type": "string", "pattern": "^https://vexil.dev/release/history/repair-proposals/.+[.]json$"}, "version": {"const": "1.0"}, "recordKind": {"const": "additive-repair-proposal"}, "proposalId": {"type": "string", "minLength": 1}, "status": {"enum": ["proposed", "approved", "rejected"]}, "anomaly": {"type": "string", "minLength": 1}, "affectedConsumers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "correctionSurface": {"type": "string", "minLength": 1}, "newIdentifier": {"type": ["string", "null"]}, "approval": {"type": ["object", "null"]}, "evidenceReferences": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "proposedActions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}
}
